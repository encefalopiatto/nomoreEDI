  "rulebook": {
    "id": "nordkauf.order.fresh-food",
    "version": 3,
    "valid_from": "2026-07-01",
    "published_by": "Nordkauf Handels GmbH (fictional)",
    "publisher_signature": {
      "method": "ed25519-public-key-signature",
      "public_key_directory_entry": "keys.procuros.example/nordkauf",
      "value": "SIG-RULEBOOK-EXAMPLE-PLACEHOLDER-ONLY"
    },
    "fields": [
      {
        "field": "order_number",
        "meaning": "The buyer's unique number for this order. Standard reference: the same thing EDIFACT calls BGM document number.",
        "required": true,
        "format": "text, max 35 characters"
      },
      {
        "field": "requested_delivery_date",
        "meaning": "The date goods must ARRIVE at the deliver_to address (not the ship date).",
        "required": true,
        "format": "calendar date"
      },
      {
        "field": "deliver_to.company_id",
        "meaning": "Identifies the warehouse that receives the goods. May differ from the ordering company and from invoice_to.",
        "required": true,
        "format": "GLN, 13 digits"
      },
      {
        "field": "lines[].product_id",
        "meaning": "The worldwide article number (GTIN) of the product.",
        "required": true,
        "format": "GTIN, 8/12/13/14 digits"
      },
      {
        "field": "lines[].ordered_quantity",
        "meaning": "How many units are ordered, in quantity_unit.",
        "required": true,
        "format": "whole number greater than zero"
      }
    ],
    "rules": [
      {
        "rule": "R-01",
        "plain_language": "Every order line must carry a product GTIN.",
        "machine_check": "content.lines.all(l, has(l.product_id))",
        "error_message": "Line {line_number}: product GTIN missing (rule R-01)."
      },
      {
        "rule": "R-02",
        "plain_language": "Ordered quantity must be greater than zero.",
        "machine_check": "content.lines.all(l, l.ordered_quantity > 0)",
        "error_message": "Line {line_number}: quantity must be greater than zero (rule R-02)."
      },
      {
        "rule": "R-03",
        "plain_language": "The order must reference the price list its prices come from.",
        "machine_check": "has(content.price_list_reference)",
        "error_message": "Price list reference missing (rule R-03)."
      },
      {
        "rule": "R-04",
        "plain_language": "Variable-weight products are ordered in pieces but priced per kilogram, so their lines must carry agreed_price_per_kg instead of agreed_unit_price.",
        "machine_check": "content.lines.all(l, !has(l.pricing_note) || l.pricing_note != 'priced_by_weight' || (has(l.agreed_price_per_kg) && !has(l.agreed_unit_price)))",
        "error_message": "Line {line_number}: variable-weight line must use price per kg (rule R-04)."
      },
      {
        "rule": "R-05",
        "plain_language": "Both dairy products in this assortment are batch-tracked: the later despatch advice must state batch number and best-before date for every line. (Stated here so the supplier knows before shipping.)",
        "applies_to": "despatch_advice",
        "machine_check": "content.lines.all(l, has(l.batch_number) && has(l.best_before_date))",
        "error_message": "Line {line_number}: batch number and best-before date required for batch-tracked goods (rule R-05)."
      }
    ],
    "scenarios": [
      {
        "scenario": "shortage",
        "plain_language": "If the supplier cannot deliver the full quantity, the order response says 'change' on that line with the quantity it CAN deliver; it never simply omits the line."
      },
      {
        "scenario": "substitution",
        "plain_language": "Substitute products are not allowed in this assortment. A product that cannot be delivered is answered with 'reject' on that line."
      }
    ],
    "code_lists": {
      "quantity_unit": {
        "pieces": "individual sales units",
        "cases": "supplier case as registered in the article master"
      },
      "line_decision": {
        "accept": "line will be delivered exactly as ordered",
        "change": "line will be delivered with the stated changed quantity or date",
        "reject": "line will not be delivered"
      }
    }
  },

  "how_to_respond": {
    "allowed_responses": [
      {
        "response_type": "order_response",
        "deadline": "within 48 hours of receiving this order",
        "must_copy": [
          { "from": "content.order_number", "to": "order_reference", "note": "echo the order number unchanged" },
          { "from": "content.lines[].line_number", "to": "lines[].line_number", "note": "keep the buyer's line numbers" }
        ],
        "you_fill_in": [
          { "field": "lines[].decision", "allowed_values_from": "code_lists.line_decision" },
          { "field": "lines[].confirmed_quantity", "note": "required when decision is 'change'" },
          { "field": "confirmed_delivery_date" }
        ]
      },
      {
        "response_type": "despatch_advice",
        "deadline": "no later than goods departure",
        "must_copy": [
          { "from": "content.order_number", "to": "order_reference" },
          { "from": "content.lines[].line_number", "to": "lines[].line_number" }
        ],
        "you_fill_in": [
          { "field": "lines[].delivered_quantity" },
          { "field": "lines[].batch_number", "note": "see rule R-05" },
          { "field": "lines[].best_before_date", "note": "see rule R-05" },
          { "field": "lines[].actual_weight_kg", "note": "required for variable-weight lines" }
        ]
      }
    ]
  },

  "connections": {
    "_note": "Informational. Use for first contact. Any CHANGE to details already on file is a proposal that must be signature-verified and, for sensitive details, human-confirmed before use.",
